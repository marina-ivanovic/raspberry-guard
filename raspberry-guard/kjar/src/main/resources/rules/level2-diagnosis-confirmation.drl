package com.ftn.sbnz.rules;

import com.ftn.sbnz.model.model.DiseaseCandidate;
import com.ftn.sbnz.model.model.Diagnosis;
import com.ftn.sbnz.model.enums.PathogenType;

rule "L2 - Confirm diagnosis: Didymella applanata"
    agenda-group "level2-diagnosis-confirmation"
    when
        accumulate(
            DiseaseCandidate(issueName == "Didymella applanata", $s: score);
            $total : sum($s);
            $total >= 4
        )
    then
        insert(new Diagnosis("Didymella applanata", PathogenType.DISEASE, $total >= 12 ? 0.95 : ($total >= 8 ? 0.85 : 0.70)));
end

