rule "L1 - Aphididae: deformed leaves and honeydew"
    agenda-group "level1-symptom-mapping"
    when
        RaspberryState()
        Symptom(name == "deformed_leaves", location == SymptomLocation.LEAF, $sev1 : severity)
        Symptom(name == "honeydew", location == SymptomLocation.LEAF, $sev2 : severity)
    then
        insert(new DiseaseCandidate("Aphididae", PathogenType.PEST, $sev1 + $sev2));
end

rule "L1 - Aphididae: deformation of fruiting twigs"
    agenda-group "level1-symptom-mapping"
    when
        RaspberryState()
        Symptom(name == "deformed_twigs", location == SymptomLocation.STEM, $sev : severity)
    then
        insert(new DiseaseCandidate("Aphididae", PathogenType.PEST, $sev));
end