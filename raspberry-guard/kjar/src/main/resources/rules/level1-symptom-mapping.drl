        Symptom(name == "round_hole_calyx", location == SymptomLocation.FLOWER, $sev : severity)
    then
        insert(new DiseaseCandidate("Byturus tomentosus", PathogenType.PEST, $sev));
end

rule "L1 - Tetranychus urtice: whitish spots on upper leaf"
    agenda-group "level1-symptom-mapping"
    when
        RaspberryState()
        Symptom(name == "whitish_spots", location == SymptomLocation.LEAF, $sev : severity)
    then
        insert(new DiseaseCandidate("Tetranychus urtice", PathogenType.PEST, $sev));
