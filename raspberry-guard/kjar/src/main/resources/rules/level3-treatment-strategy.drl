package com.ftn.sbnz.rules;

import com.ftn.sbnz.model.model.Diagnosis;
import com.ftn.sbnz.model.model.RaspberryState;
import com.ftn.sbnz.model.model.TreatmentPlan;
import com.ftn.sbnz.model.model.Symptom;
import com.ftn.sbnz.model.enums.GrowthPhase;
import com.ftn.sbnz.model.enums.PathogenType;

rule "L3 - Create Plan for Diagnosis"
    agenda-group "level3-treatment-strategy"
    salience 100
    when
        $dx : Diagnosis()
        not TreatmentPlan(diagnosis == $dx)
    then
        insert(new TreatmentPlan($dx));
end

rule "L3 - Treatment: Didymella applanata - agrotechnical"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Didymella applanata")
        $plan : TreatmentPlan(diagnosis == $dx)
        RaspberryState(currentPhase != GrowthPhase.HARVEST)
    then
        $plan.addTreatment("AGROTECHNICAL: Remove and burn infected shoots immediately after harvest.");
        $plan.addTreatment("AGROTECHNICAL: Avoid high planting density for better ventilation.");
end

rule "L3 - Treatment: Didymella applanata - harvest"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Didymella applanata")
        $plan : TreatmentPlan(diagnosis == $dx)
        RaspberryState(currentPhase == GrowthPhase.HARVEST)
    then
        $plan.addAlert("WARNING: Chemical treatment is not allowed during harvest!");
        $plan.addTreatment("MECHANICAL: Manually remove and destroy infected shoots.");
end

rule "L3 - Treatment: Botrytis cinerea - agrotechnical"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Botrytis cinerea")
        $plan : TreatmentPlan(diagnosis == $dx)
    then
        $plan.addTreatment("AGROTECHNICAL: Improve ventilation within the plantation — pruning.");
        $plan.addTreatment("AGROTECHNICAL: Remove infected fruits immediately upon detection.");
end

rule "L3 - Treatment: Aphididae - agrotechnical and biological"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Aphididae")
        $plan : TreatmentPlan(diagnosis == $dx)
        RaspberryState(currentPhase != GrowthPhase.FLOWERING)
    then
        $plan.addTreatment("BIOLOGICAL: Encourage the presence of natural enemies (ladybugs).");
        $plan.addTreatment("AGROTECHNICAL: Apply water sprays for mechanical removal of colonies.");
end

rule "L3 - Treatment: Aphididae - during flowering"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Aphididae")
        $plan : TreatmentPlan(diagnosis == $dx)
        RaspberryState(currentPhase == GrowthPhase.FLOWERING)
    then
        $plan.addAlert("WARNING: Insecticides are STRICTLY FORBIDDEN during flowering to protect bees!");
        $plan.addTreatment("AGROTECHNICAL: Manually remove twigs with the most colonies.");
end

rule "L3 - Treatment: Tetranychus urtice - agrotechnical"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Tetranychus urtice")
        $plan : TreatmentPlan(diagnosis == $dx)
    then
        $plan.addTreatment("AGROTECHNICAL: Ensure optimal irrigation, mites multiply in drought.");
end

rule "L3 - Treatment: Leptosphaeria coniothyrium - agrotechnical"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Leptosphaeria coniothyrium")
        $plan : TreatmentPlan(diagnosis == $dx)
    then
        $plan.addTreatment("AGROTECHNICAL: Prune and burn infected canes. Avoid mechanical injuries.");
end

rule "L3 - Treatment: Verticillium albo-atrum"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Verticillium albo-atrum")
        $plan : TreatmentPlan(diagnosis == $dx)
    then
        $plan.addAlert("WARNING: There is no effective chemical cure for Verticillium wilt!");
        $plan.addTreatment("AGROTECHNICAL: Uproot and burn the entire infected plant including the roots.");
        $plan.addTreatment("PREVENTION: Crop rotation. Do not plant raspberries after tomatoes, potatoes, or strawberries.");
end

rule "L3 - Treatment: Lasioptera rubi"
    agenda-group "level3-treatment-strategy"
    when
        $dx : Diagnosis(issueName == "Lasioptera rubi")
        $plan : TreatmentPlan(diagnosis == $dx)
    then
        $plan.addAlert("WARNING: Chemicals are ineffective because the larva is protected inside the gall.");
        $plan.addTreatment("MECHANICAL: Cut the cane BELOW the gall and burn it during autumn/winter.");
end

rule "L3 - Treatment: Urgent Severity Alert"
    agenda-group "level3-treatment-strategy"
    when
        $plan : TreatmentPlan()
        exists(Symptom(getSeverity() >= 8))
    then
        $plan.addAlert("URGENT: Critical symptom severity detected (>=8)! React within 24h.");
end

rule "L3 - Create preventive plan from RiskAlert"
    agenda-group "level3-treatment-strategy"
    when
        $alert : RiskAlert()
    then
        Diagnosis prevDx = new Diagnosis("PREVENTIVE RISK: " + $alert.getPathogen(), PathogenType.DISEASE, 1.0);
        TreatmentPlan plan = new TreatmentPlan(prevDx);
        plan.addAlert("CEP ALARM (" + $alert.getRiskLevel() + "): " + $alert.getRecommendation());
        insert(plan);
end